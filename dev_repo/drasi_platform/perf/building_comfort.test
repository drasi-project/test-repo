test_id: building_comfort
version: 1
description: Building Comfort Model
test_folder: building_comfort

# Data sources that feed into the Drasi system
sources:
  # Test source representing a facilities database
  - test_source_id: facilities-db
    # Source type: Model-based synthetic data generator
    kind: Model

    # How change events are delivered to Drasi
    source_change_dispatchers:
      # Using Redis for event delivery
      - kind: RedisStream
        host: drasi-redis
        port: 6379

    # Configuration for synthetic data generation
    model_data_generator:
      # Generate a building hierarchy (buildings -> floors -> rooms)
      kind: BuildingHierarchy

      # Total number of change events to generate during the test
      change_count: 100000

      # Time intervals (in nanoseconds) between change events
      # Array defines different interval patterns: [2s, 0.5s, 0.5s, 4s]
      change_interval:
        - 2000000000   # 2 seconds
        - 500000000    # 0.5 seconds
        - 500000000    # 0.5 seconds
        - 4000000000   # 4 seconds

      # Random seed for reproducible test runs
      seed: 123456789

      # Spacing mode: 'none' means no additional spacing logic
      spacing_mode: none

      # Start time for generated timestamps
      time_mode: "live"

      # Number of buildings to generate: [count, variance]
      # [1, 0] means exactly 1 building, no variance
      building_count: [1, 0]

      # Number of floors per building: [count, variance]
      # [1, 0] means exactly 1 floor per building
      floor_count: [1, 0]

      # Number of rooms per floor: [count, variance]
      # [1, 0] means exactly 1 rooms per floor
      room_count: [1, 0]

      # Sensor definitions for each room
      room_sensors:
        # Temperature sensor configuration
        - id: temperature                         # Sensor property name
          kind: NormalFloat                       # Normal distribution float values
          momentum_init: [5, 1, 0.5]              # initial momentum - [mean, std_dev, decay] 
          value_change: [1, 0]                    # per-change delta - [mean, std_dev]
          value_init: [5000, 0]                   # initial value - [mean, std_dev]
          value_range: [0, 10000]                 # valid range[min, max]

        # CO2 sensor configuration
        - id: co2
          kind: NormalFloat
          momentum_init: [10, 1, 0.5]             # Higher momentum for CO2 fluctuation
          value_change: [1, 0]
          value_init: [5000, 0]
          value_range: [0, 10000]

        # Humidity sensor configuration
        - id: humidity
          kind: NormalFloat
          momentum_init: [5, 1, 0.5]
          value_change: [1, 0]
          value_init: [5000, 0]
          value_range: [0, 10000]

    # Which queries subscribe to this source's data
    subscribers:
      - node_id: default
        query_id: room-comfort-level

# Query definitions for processing the source data
queries:
  # Query to analyze room comfort levels
  - test_query_id: room-comfort-level

    # Where query results are sent
    result_stream_handler:
      kind: RedisStream
      host: drasi-redis
      port: 6379
      stream_name: room-comfort-level-results
      # Don't process entries that existed before test started
      process_old_entries: false

    # When to stop the test
    stop_trigger:
      # Stop after receiving a specific number of result records
      kind: RecordCount
      # Stop after 100000 records (matches change_count above)
      record_count: 100000
